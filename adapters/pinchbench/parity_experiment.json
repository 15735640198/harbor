      "model": "openai/gpt-4o"
    },
    {
      "name": "aider",
      "model": "openai/gpt-4o"
    }
  ],
  "evaluation": {
    "n_runs": 2,
    "metrics": ["pass_rate", "mean_score", "time_per_task"]
  }
}
