{
  "name": "PinchBench Parity Experiment",
  "description": "Parity evaluation of different agents on PinchBench benchmark",
  "tasks": ["all"],
  "agents": [
    {
      "name": "oracle",
      "model": "oracle"
    },
    {
      "name": "claude-code",
      "model": "anthropic/claude-3-5-sonnet-20241022"
    },
    {
